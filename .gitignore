# ============================================================================
# RazorGrowth AI — .gitignore
#
# Scope: FastAPI + SQLAlchemy backend, React + TypeScript + Vite frontend,
#        PostgreSQL/pgvector (Docker), Alembic migrations, pytest suite.
#
# NOTE: `.env.example` files (root and backend/) are intentionally NOT
#       ignored — they are tracked as configuration templates.
# ============================================================================

# ── Environment variables & secrets ─────────────────────────────────────────
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.crt
secrets.*

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Testing & coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.tox/
.nox/
.ruff_cache/
.mypy_cache/

# ── Node.js / frontend build output ─────────────────────────────────────────
node_modules/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Local databases ──────────────────────────────────────────────────────────
# SQLite dev databases (e.g. razorgrowth.db) and journal/WAL sidecars.
# Production PostgreSQL data lives in the Docker named volume, not in Git.
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# ── AI / model caches & generated artifacts ──────────────────────────────────
.cache/
embeddings_cache/
model_cache/

# ── Docker-generated files ───────────────────────────────────────────────────
docker-compose.override.yml

# ── Temporary files & scratch artifacts ──────────────────────────────────────
tmp/
.tmp/
temp/
*.tmp
*.bak
*.orig

# ── IDE / editor files ───────────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp

# ── OS-specific files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================================
# Review notes (over-ignoring audit):
# - `env/` only matches directories named `env`, never `migrations/env.py`.
# - `dist/` matches Vite/Python build output; no source code lives there.
# - `*.db` hides only local SQLite databases; no tracked file uses this suffix.
# - Migrations (`migrations/versions/*.py`), tests (`tests/`) and both
#   `.env.example` templates remain fully trackable.
# ============================================================================
