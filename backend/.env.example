# ============================================================================
# RazorGrowth AI — backend-local development template
#
# For running the backend OUTSIDE Docker (uvicorn from the repo root):
#     pip install -r requirements.txt
#     docker compose up -d db        # PostgreSQL 16 + pgvector on :5432
#     alembic upgrade head
#     uvicorn backend.app.main:app --host 127.0.0.1 --port 8001
#
# Settings are read from the REPO-ROOT .env by default (pydantic-settings
# resolves relative to the working directory); this file exists as a
# reference for local backend-only development.
# ============================================================================

APP_ENV=development
# Local (non-Docker) backend: postgres is exposed on localhost:5432
DATABASE_URL=postgresql://razorgrowth:razorgrowth@localhost:5432/razorgrowth

# JWT signing key (>= 32 chars) — required for login/signup
AUTH_SECRET_KEY=

# Razorpay TEST-mode credentials (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
