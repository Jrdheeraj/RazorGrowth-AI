# ============================================================================
# RazorGrowth AI — environment template
#
# Copy to `.env` (repo root) and adjust. `docker compose` reads it
# automatically. All variables are OPTIONAL for the judge/local run except
# AUTH_SECRET_KEY, which must be set to any random string ≥ 32 characters
# so login/signup (JWT signing) works.
#
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# PowerShell:   -join ((48..90) + (97..122) | Get-Random -Count 48 | % {[char]$_})
#
# NEVER commit a real .env file. Secrets stay local.
# ============================================================================

# ── SECTION 1: REQUIRED FOR LOCAL / JUDGE RUN ───────────────────────────────

# JWT signing key for auth tokens (>= 32 characters, any random string).
AUTH_SECRET_KEY=change-me-to-a-random-32-plus-character-secret

# ── SECTION 2: DOCKER COMPOSE (sensible defaults; uncomment to change) ──────

# PostgreSQL container credentials — used by BOTH the db service and the
# backend connection string automatically. Change them together.
POSTGRES_DB=razorgrowth
POSTGRES_USER=razorgrowth
POSTGRES_PASSWORD=razorgrowth
POSTGRES_PORT=5432            # host port for postgres (change if 5432 is busy)
BACKEND_PORT=8001             # host port for the API  (http://localhost:8001)
FRONTEND_PORT=5173            # host port for the app  (http://localhost:5173)

# Set true to seed the deterministic demo dataset (demo merchant, 10
# products, 60 customers, 240 orders) on every backend startup. The seed
# is idempotent. Default false — signup creates your own workspace.
SEED_DEMO_DATA=false

APP_ENV=development           # development | testing | production
AUTH_MODE=required            # every non-public endpoint needs a Bearer token

# ── SECTION 3: OPTIONAL — EXTERNAL INTEGRATIONS (Razorpay TEST mode) ────────
# Leave empty to run without Razorpay. NEVER use LIVE keys in .env.example.
# Razorpay TEST credentials come from the Razorpay dashboard (TEST mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ENABLED=false        # true enables TEST-mode integration
RAZORPAY_TEST_MODE=false      # true selects the deterministic simulated adapter
REAL_TEST_INTEGRATION_ENABLED=false
RAZORPAY_WEBHOOK_SECRET=      # HMAC-SHA256 webhook signature secret

# ── SECTION 4: OPTIONAL — AI / LLM FEATURES ─────────────────────────────────
# Without keys the app runs fully; AI features return a clear 503
# "provider not configured" and agents fall back to deterministic mode.
LLM_PROVIDER=openai          # openai | groq
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── SECTION 5: OPTIONAL — SECURITY TUNING (defaults are safe) ────────────────
AUTH_ENABLE_REGISTRATION=true
PASSWORD_MIN_LENGTH=12        # plus >=1 letter and >=1 digit
# Comma-separated origins allowed to call the API from a browser. The
# Docker frontend is same-origin (nginx proxy), so the default is fine.
CORS_ORIGINS=
TRUSTED_HOSTS=*
SECURITY_HEADERS_ENABLED=true
ENABLE_DOCS=true              # interactive /docs page
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_WEBHOOK_REQUESTS=60
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
EXECUTION_ENABLED=false       # global action-execution kill switch
GUARDRAIL_MAX_AMOUNT_INR=50000
GUARDRAIL_REQUIRE_APPROVAL=true
