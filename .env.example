# ============================================================================
# RazorGrowth AI — environment template
#
# Copy to `.env` (repo root) and adjust. `docker compose` reads it
# automatically. All variables are OPTIONAL for the judge/local run except
# AUTH_SECRET_KEY, which must be set to any random string ≥ 32 characters
# so login/signup (JWT signing) works.
#
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# PowerShell:   -join ((48..90) + (97..122) | Get-Random -Count 48 | % {[char]$_})
#
# NEVER commit a real .env file. Secrets stay local.
# ============================================================================

# ==============================
# APPLICATION / SECURITY
# ==============================

# JWT signing key for auth tokens (>= 32 characters, any random string).
AUTH_SECRET_KEY=change-me-to-a-random-32-plus-character-secret

# Dedicated Fernet key (urlsafe-base64, 32 bytes) for credential
# encryption at rest. Empty = derived from AUTH_SECRET_KEY (dev only;
# production should set an explicit key — startup logs a warning).
INTEGRATION_CREDENTIAL_KEY=

# Global action-execution kill switch. Keep false until you explicitly
# want the Marketing Agent to perform real external writes.
EXECUTION_ENABLED=false

# Application environment: development | testing | production
APP_ENV=development
# Required mode: every merchant-scoped endpoint needs a valid Bearer token.
AUTH_MODE=required
AUTH_ENABLE_REGISTRATION=true
PASSWORD_MIN_LENGTH=12
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=
TRUSTED_HOSTS=*
SECURITY_HEADERS_ENABLED=true
ENABLE_DOCS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_WEBHOOK_REQUESTS=60
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
GUARDRAIL_MAX_AMOUNT_INR=50000
GUARDRAIL_REQUIRE_APPROVAL=true
APPROVAL_EXPIRY_DAYS=
CAMPAIGN_MAX_TARGET=
DISCOUNT_MAX_PERCENTAGE=100.0
DISCOUNT_MAX_AMOUNT_INR=50000.0
MEASUREMENT_REQUIRE_REAL_DATA=true

# ==============================
# DATABASE
# ==============================

# PostgreSQL container credentials — used by BOTH the db service and the
# backend connection string automatically. Change them together.
POSTGRES_DB=razorgrowth
POSTGRES_USER=razorgrowth
POSTGRES_PASSWORD=razorgrowth
POSTGRES_PORT=5432
BACKEND_PORT=8001
FRONTEND_PORT=5173
DATABASE_URL=postgresql://razorgrowth:razorgrowth@localhost:5432/razorgrowth

# Set true to seed the deterministic demo dataset (demo merchant, 10
# products, 60 customers, 240 orders) on every backend startup. The seed
# is idempotent. Default false — signup creates your own workspace.
SEED_DEMO_DATA=false

# ==============================
# RAZORPAY
# ==============================

# Leave empty to run without Razorpay. NEVER use LIVE keys in .env.example.
# Razorpay TEST credentials come from the Razorpay dashboard (TEST mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ENABLED=false
RAZORPAY_TEST_MODE=false
REAL_TEST_INTEGRATION_ENABLED=false
RAZORPAY_WEBHOOK_SECRET=

# ==============================
# LLM
# ==============================

# Without keys the app runs fully; AI features return a clear 503
# "provider not configured" and agents fall back to deterministic mode.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2048

# ==============================
# EMAIL — RESEND
# ==============================

# Platform default sender. Workspaces can also connect their own Resend
# key via the Marketing Agent UI — these are only fallbacks.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=RazorGrowth

# ==============================
# GOOGLE ADS
# ==============================

# Platform default Google Cloud client. Since the September 2026
# developer-token sunset, no developer token is required (API access is
# governed by the Cloud project's access level). The variable below is an
# optional legacy passthrough and may stay empty.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25

# ==============================
# META ADS / INSTAGRAM
# ==============================

# Platform default Meta App. Workspaces connect via the UI with their
# own ad accounts / IG business accounts. Instagram uses the same Meta
# OAuth app — no separate Instagram key is required.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=
META_GRAPH_VERSION=v24.0
