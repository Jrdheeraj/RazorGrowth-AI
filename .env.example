APP_ENV=development
DATABASE_URL=postgresql://razorgrowth:razorgrowth@localhost:5432/razorgrowth
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── AI provider configuration ────────────────────────────────────────────────
# LLM provider: currently only "openai" is supported
LLM_PROVIDER=openai
# Model: gpt-4o-mini is recommended (cost-effective, supports JSON mode)
LLM_MODEL=gpt-4o-mini
# Your OpenAI API key — never commit this value
LLM_API_KEY=

# Embedding provider: currently only "openai" is supported
EMBEDDING_PROVIDER=openai
# Embedding model: text-embedding-3-small (1536 dims, cost-effective)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
