APP_ENV=development
DATABASE_URL=postgresql://razorgrowth:razorgrowth@localhost:5432/razorgrowth

# ── Phase 6 — Authentication & multi-tenancy ─────────────────────────────────
# AUTH_MODE:
#   required (DEFAULT, secure): every non-public endpoint needs a Bearer token.
#   optional (development convenience ONLY): unauthenticated requests fall back
#     to legacy single-tenant behaviour. Production startup REFUSES to run
#     unless AUTH_MODE=required.
AUTH_MODE=optional
# Signing key for JWT access tokens. NEVER commit a real value.
# Production requires >= 32 characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Allow public self-registration via POST /api/auth/register (disable for private deployments).
AUTH_ENABLE_REGISTRATION=true
# Password policy: minimum length (plus >=1 letter and >=1 digit enforced).
PASSWORD_MIN_LENGTH=12

# CORS: comma-separated origins allowed to call the API from a browser.
# Empty = same-origin only (most restrictive). Example: http://localhost:5173
CORS_ORIGINS=
# Trusted hosts (comma-separated). "*" is development-only; production must
# list explicit hostnames or the server refuses to start.
TRUSTED_HOSTS=*
SECURITY_HEADERS_ENABLED=true
# Interactive docs (/docs, /openapi.json). Empty = auto (off in production).
ENABLE_DOCS=

# Rate limiting (sliding window, per client IP per bucket).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_WEBHOOK_REQUESTS=60
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60

# ── Razorpay integration boundary ────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Test mode: deterministic simulated adapter (no network, no real money).
# Requires RAZORPAY_ENABLED=true to become active; live execution remains
# refused until deliberately implemented behind both flags.
RAZORPAY_ENABLED=false
RAZORPAY_TEST_MODE=false
# Webhook signing secret (Razorpay dashboard -> Webhooks). Required for
# POST /api/webhooks/razorpay to accept deliveries; without it the endpoint
# fails closed with WEBHOOK_NOT_CONFIGURED.
RAZORPAY_WEBHOOK_SECRET=

# ── Phase 4/5 — safety switches ──────────────────────────────────────────────
# Global execution switch: agents may PROPOSE actions regardless, but nothing
# executes unless this is explicitly true. In production, false (default)
# blocks ALL execution at the service layer.
EXECUTION_ENABLED=false
# Guardrails: max single-action amount (INR); approval gate cannot be disabled
GUARDRAIL_MAX_AMOUNT_INR=50000
GUARDRAIL_REQUIRE_APPROVAL=true
# Approval expiry in days (empty = no expiry)
APPROVAL_EXPIRY_DAYS=
# Campaign & discount limits
CAMPAIGN_MAX_TARGET=
DISCOUNT_MAX_PERCENTAGE=100.0
DISCOUNT_MAX_AMOUNT_INR=50000.0
# Measurement honesty: never fabricate revenue when real data is missing
MEASUREMENT_REQUIRE_REAL_DATA=true

# ── AI provider configuration ────────────────────────────────────────────────
# LLM provider: "openai" or "groq"
LLM_PROVIDER=openai
# Model: gpt-4o-mini is recommended (cost-effective, supports JSON mode)
LLM_MODEL=gpt-4o-mini
# Your OpenAI API key — never commit this value
LLM_API_KEY=

# ── Groq (used when LLM_PROVIDER=groq) ───────────────────────────────────────
# Your Groq API key — never commit this value
GROQ_API_KEY=
# Groq model (production): openai/gpt-oss-120b, openai/gpt-oss-20b, ...
GROQ_MODEL=openai/gpt-oss-120b

# Embedding provider: currently only "openai" is supported
EMBEDDING_PROVIDER=openai
# Embedding model: text-embedding-3-small (1536 dims, cost-effective)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
