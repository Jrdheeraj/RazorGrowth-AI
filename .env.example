# ============================================================================
# RazorGrowth AI — environment template
#
# Copy to `.env` (repo root) and adjust. `docker compose` reads it
# automatically. All variables are OPTIONAL for the judge/local run except
# AUTH_SECRET_KEY, which must be set to any random string ≥ 32 characters
# so login/signup (JWT signing) works.
#
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# PowerShell:   -join ((48..90) + (97..122) | Get-Random -Count 48 | % {[char]$_})
#
# NEVER commit a real .env file. Secrets stay local.
# ============================================================================

# ==============================
# APPLICATION / SECURITY
# ==============================

# JWT signing key for auth tokens (>= 32 characters, any random string).
AUTH_SECRET_KEY=change-me-to-a-random-32-plus-character-secret

# Dedicated Fernet key (urlsafe-base64, 32 bytes) for credential
# encryption at rest. Empty = derived from AUTH_SECRET_KEY (dev only;
# production should set an explicit key — startup logs a warning).
# Generate one (NEVER reuse AUTH_SECRET_KEY or a predictable string):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_CREDENTIAL_KEY=

# ─────────────────────────────────────────────────────────────────────────
# EXTERNAL EXECUTION — the single switch for every real external write
# ─────────────────────────────────────────────────────────────────────────
# This is the ONLY setting that permits the platform to perform a real
# external write (sending an email, publishing a post, creating an ad
# campaign). It is read through backend/app/core/execution_policy.py, which
# is the single authoritative policy: the MCP gate, the action pipeline and
# every executor all resolve the same answer from here.
#
# DEFAULT IS OFF, IN EVERY ENVIRONMENT. That is deliberate: approving an
# action is not permission to contact a real provider.
#
# While it is off, an approved campaign returns an explicit PREVIEW
# (delivery_status = "preview_only") and NO provider call is made at all.
# Nothing is marked as sent, and the action stays retryable — so turning the
# switch on later lets the very same approved action deliver for real.
#
# Accepted values: true | false | 1 | 0 | yes | no | on | off
# Any other value fails CLOSED (treated as disabled) so a typo can never
# enable sending to real customers.
#
# To enable authorized sending:
#   1. set EXECUTION_ENABLED=true
#   2. restart the backend (the setting is snapshotted per MCP run)
#   3. configure Resend (RESEND_API_KEY + RESEND_FROM_EMAIL below, or
#      connect Resend per workspace in the Marketing Agent integration hub)
#   4. approve the campaign action in /actions and execute it
EXECUTION_ENABLED=false

# Optional hard ceiling on how many recipients one campaign may target.
# Empty = unlimited. Recommended to set in production.
CAMPAIGN_MAX_TARGET=

# Application environment: development | testing | production
APP_ENV=development
# Required mode: every merchant-scoped endpoint needs a valid Bearer token.
AUTH_MODE=required
AUTH_ENABLE_REGISTRATION=true
PASSWORD_MIN_LENGTH=12
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=
TRUSTED_HOSTS=*
SECURITY_HEADERS_ENABLED=true
ENABLE_DOCS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_WEBHOOK_REQUESTS=60
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
GUARDRAIL_MAX_AMOUNT_INR=50000
GUARDRAIL_REQUIRE_APPROVAL=true
APPROVAL_EXPIRY_DAYS=
CAMPAIGN_MAX_TARGET=
DISCOUNT_MAX_PERCENTAGE=100.0
DISCOUNT_MAX_AMOUNT_INR=50000.0
MEASUREMENT_REQUIRE_REAL_DATA=true

# ==============================
# DATABASE
# ==============================

# PostgreSQL container credentials — used by BOTH the db service and the
# backend connection string automatically. Change them together.
POSTGRES_DB=razorgrowth
POSTGRES_USER=razorgrowth
POSTGRES_PASSWORD=razorgrowth
POSTGRES_PORT=5432
BACKEND_PORT=8001
FRONTEND_PORT=5173
DATABASE_URL=postgresql://razorgrowth:razorgrowth@localhost:5432/razorgrowth

# Set true to seed the deterministic demo dataset (demo merchant, 10
# products, 60 customers, 240 orders) on every backend startup. The seed
# is idempotent. Default false — signup creates your own workspace.
SEED_DEMO_DATA=false

# ==============================
# RAZORPAY
# ==============================

# Leave empty to run without Razorpay. NEVER use LIVE keys in .env.example.
# Razorpay TEST credentials come from the Razorpay dashboard (TEST mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ENABLED=false
RAZORPAY_TEST_MODE=false
REAL_TEST_INTEGRATION_ENABLED=false
RAZORPAY_WEBHOOK_SECRET=

# ==============================
# LLM - Cloudflare Workers AI
# ==============================

# Cloudflare Workers AI is the single text-LLM provider for the whole
# application. Every agent, route, worker and RAG path resolves its client
# through backend/app/ai/llm/provider.py::resolve_llm_provider(), so this one
# setting routes ALL text generation.
#
# The credentials are SHARED with the Designer Agent's FLUX image generation
# (the CLOUDFLARE_* values further down): one account, one token, two
# modalities. The token is server-side only and never reaches the browser.
#
# Without these the app still runs; AI features return a clear 503
# "provider not configured" and agents fall back to deterministic mode
# honestly, rather than fabricating results.
LLM_PROVIDER=cloudflare
# Text model. Defaults to @cf/zai-org/glm-4.7-flash (131k context; documented
# function-calling and response_format support). Confirm availability for your
# account before depending on a specific model.
CLOUDFLARE_TEXT_MODEL=@cf/zai-org/glm-4.7-flash
# Optional alternative provider. Empty by default: switching to OpenAI is a
# deliberate act (set BOTH LLM_PROVIDER=openai AND LLM_API_KEY).
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2048

# ==============================
# EMAIL — RESEND
# ==============================

# Platform default sender. Workspaces can also connect their own Resend
# key via the Marketing Agent UI - these are only fallbacks.
#
# NOTE: with EXECUTION_ENABLED=false these are never used to SEND - they are
# only read to decide whether a preview can report that a sender exists.
# A real send additionally verifies the key against Resend before sending.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=RazorGrowth

# ==============================
# DESIGNER AGENT — IMAGE GENERATION
# ==============================
#
# Optional. The Designer Agent produces structured briefs, specifications
# and variants as TEXT and needs none of this. When enabled it can additionally
# render a real JPEG per asset via Cloudflare Workers AI
# (@cf/black-forest-labs/flux-1-schnell).
#
# OFF BY DEFAULT. Image generation is the only Designer capability that can
# spend money on an external provider, so it must be opted into explicitly.
# A missing flag or a missing credential is reported honestly as
# "unavailable" — it is never faked and never silently substituted.
#
# Create the token in Cloudflare under Workers AI -> "Use REST API" ->
# "Create a Workers AI API Token" (it carries Workers AI read permission).
# Both values are read on the BACKEND ONLY and are never returned by an API,
# logged, or sent to the browser.
IMAGE_GENERATION_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Resource limits. The defaults are deliberately conservative; a workspace
# cannot exceed them without an operator editing these values.
# IMAGE_MAX_BYTES=4194304
# IMAGE_REQUEST_TIMEOUT_SECONDS=60
# IMAGE_MAX_RETRIES=2
# IMAGE_DAILY_QUOTA_PER_MERCHANT=50
# IMAGE_DAILY_STORAGE_QUOTA_BYTES=67108864
# IMAGE_MAX_WIDTH=2048
# IMAGE_MAX_HEIGHT=2048
# IMAGE_MAX_PIXELS=4194304

# ==============================
# GOOGLE ADS
# ==============================

# Platform default Google Cloud client. A developer token is sent on
# Google Ads API calls ONLY when set: projects enrolled in Google's
# token-less access may leave it empty, and when Google requires the
# header the API answers requestError.DEVELOPER_TOKEN_PARAMETER_MISSING
# (surfaced as MISSING_CONFIGURATION, never raw Google JSON).
#
# REQUIRED FOR LIVE GOOGLE ADS API ACCESS — real token from
# Google Ads > API Central. Explicit placeholder (fill this in):
#   <REPLACE_WITH_REAL_GOOGLE_ADS_DEVELOPER_TOKEN>
# Leave the active value empty until you have the real token: any
# non-empty value is transmitted to Google as the `developer-token`
# header, so a placeholder would be rejected outright.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8001/api/marketing-agi/integrations/google_ads/oauth/callback
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_API_VERSION=v25

# Merchant-facing frontend origin. OAuth callbacks land on the backend
# (no auth header) and redirect here with ONLY integration/status/code —
# never tokens or provider payloads.
FRONTEND_BASE_URL=http://localhost:5173

# ==============================
# META ADS / INSTAGRAM
# ==============================

# Platform default Meta App. Workspaces connect via the UI with their
# own ad accounts / IG business accounts. Instagram uses the same Meta
# OAuth app — no separate Instagram key is required.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=
META_GRAPH_VERSION=v24.0

# ---------------------------------------------------------------------------
# Autonomous research (web search + public page retrieval)
# ---------------------------------------------------------------------------
# Vendor-neutral. Point the endpoint at whichever search API you have a
# credential for; the response shape is mapped with the *_FIELD settings.
# With these unset, research-capable agents report `unavailable` with this
# exact reason and degrade honestly. They never invent sources or findings.
RESEARCH_SEARCH_ENDPOINT=
RESEARCH_API_KEY=
# Dotted path to the results array inside the provider's JSON response.
RESEARCH_RESULTS_PATH=results
RESEARCH_TITLE_FIELD=title
RESEARCH_URL_FIELD=url
RESEARCH_SNIPPET_FIELD=snippet
